# =============================================================================
#  AuthSec - Docker Compose configuration
#  cp .env.example .env  &&  chmod 600 .env  &&  edit
# =============================================================================

# --- your domain -------------------------------------------------------------
# Three hostnames must resolve to this machine:
#   app.<DOMAIN>    web UI
#   api.<DOMAIN>    API
#   oauth.<DOMAIN>  OAuth2 / OIDC issuer
DOMAIN=example.com
ACME_EMAIL=ops@example.com
ORG_NAME=Example Inc

# --- container images --------------------------------------------------------
REGISTRY=docker-repo-public.authnull.com
IMAGE_TAG=production

# --- database ----------------------------------------------------------------
DB_USER=authsec
DB_NAME=authsec
# Avoid @ : / ? # in this password. If you use any, percent-encode them in
# DB_PASSWORD_URLENCODED below (@ = %40, : = %3A, / = %2F, # = %23).
DB_PASSWORD=CHANGE_ME_db_password
DB_PASSWORD_URLENCODED=CHANGE_ME_db_password

# --- object storage for logs -------------------------------------------------
MINIO_ROOT_USER=authsec
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# --- secrets: generate every one of these ------------------------------------
#   openssl rand -hex 32       (for the *_SECRET / *_KEY values)
#   openssl rand -base64 32    (for ENCRYPTION_KEY)
JWT_SECRET=CHANGE_ME
JWT_DEF_SECRET=CHANGE_ME
JWT_SDK_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME
OIDC_STATE_HMAC_KEY=CHANGE_ME
TOTP_ENCRYPTION_KEY=CHANGE_ME
SYNC_CONFIG_ENCRYPTION_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
HYDRA_SECRETS_SYSTEM=CHANGE_ME
HYDRA_SECRETS_COOKIE=CHANGE_ME

# --- Vault -------------------------------------------------------------------
# Left empty on the first run. ./vault-init.sh fills it in after initialising
# Vault; then restart the stack.
VAULT_TOKEN=

# --- email (optional, needed for verification and invitation mail) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
